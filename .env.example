# Gateway unico: mismo codigo en prod y local (12-Factor III: todo por env)
PORT=8000
# TTL 60 confirmado en S10: fit doble p95 local <1s, T4 real pendiente Step 4.
# Presupuesto stages: landmarks 5 + fit 10 + texture 30 dentro del total.
R2_TTL_SECONDS=60
RUNNER_WEBHOOK_URL=http://runner:8001/hooks/queue
RUNNER_PORT=8001
GATEWAY_URL=http://localhost:8000
ML_SIDECAR_URL=http://ml-sidecar:8081
VITE_API_URL=http://localhost:8000
# Prod (Cloudflare + Modal): todo secreto via GitHub Environments / modal secret.
# CLOUDFLARE_API_TOKEN= (requerido prod)
# CLOUDFLARE_ACCOUNT_ID= (requerido prod)
# CLOUDFLARE_QUEUE_ID=vultus-jobs (requerido prod)
# R2_BUCKET=vultus-jobs (requerido: jobs + contexto operativo del gate sync)
# R2_ACCESS_KEY_ID= (requerido prod)
# R2_SECRET_ACCESS_KEY= (requerido prod)
# VULTUS_API_URL=https://api.vultus.esau.com.mx (requerido prod)
# MODAL_TOKEN_ID= (requerido prod)
# MODAL_TOKEN_SECRET= (requerido prod)
# Puente FLAME/DECA (requerido para forward real; vacio = doble local):
# WEIGHTS_ROOT=/weights (opcional: raiz del Volume montado; default /weights)
# WEIGHTS_DIR=/weights (alias compat de WEIGHTS_ROOT, aun leido por gnm_assemble)
# GNM_ASSETS_DIR=/weights/gnm (opcional: default $WEIGHTS_ROOT/gnm)
# DECA_DIR=/weights/deca (requerido real: contiene deca_model.tar)
# FLAME_ASSETS_DIR=/weights/flame (requerido real: flame2023_Open.pkl o generic_model.pkl)
# FFHQ_UV_DIR=/weights/ffhq-uv (requerido real: FLAME_w_HIFI3D_UV.obj + eye_ball_tex.png)
# TEXGAN_DIR=/weights/checkpoints/texgan_model (real: texgan_ffhq_uv.pth)
# DEEP3D_DIR=/weights/checkpoints/deep3d_model (real: epoch_latest.pth)
# TOPO_DIR=/weights/topo_assets (real: unwrap_1024_info.mat)
# MODAL_VOLUME=vultus-weights (requerido: Volume del puente en scripts/modal-weights-sync.sh)
# FLAME_CUTOVER=1 (requerido solo backup/rm: flag de codigo FLAME desplegado)
# BACKUP_TAG=2026-09-28 (requerido solo backup/rm/--check post-cutover)
# VULTUS_REAL_ML=0 (opcional: 1 exige real y falla loud sin pesos, 0 fuerza dobles)
