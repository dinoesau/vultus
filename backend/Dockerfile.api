# syntax=docker/dockerfile:1
# API local Python (sin Rust). Duena de API local, cola en memoria,
# orquestador local y bake CPU. TS es fuente de verdad del contrato HTTP.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /work
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-api.txt ./backend/requirements-api.txt
RUN --mount=type=cache,target=/root/.cache/pip pip3 install -r backend/requirements-api.txt
COPY backend/domain.py ./backend/domain.py
COPY backend/store.py ./backend/store.py
COPY backend/gnm.py ./backend/gnm.py
COPY backend/pipeline_local.py ./backend/pipeline_local.py
COPY backend/app.py ./backend/app.py
COPY backend/assets ./backend/assets
ENV PORT=8000 QUEUE_DRIVER=memory R2_TTL_SECONDS=60 ML_SIDECAR_URL=http://ml-sidecar:8081
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1
CMD ["sh", "-c", "uvicorn backend.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
