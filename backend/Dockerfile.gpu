# syntax=docker/dockerfile:1
# ML sidecar GPU (Python). El binario Rust NO va aquí.
# Uso LOCAL (compose/docker): esta imagen levanta el sidecar para paridad.
# Modal USA la receta en backend/modal_app.py (from_registry + mounts), no
# este Dockerfile: asi los deploys de solo-codigo no reconstruyen la imagen.
# Mantener en paridad: misma base devel, mismo orden torch-cu126 primero.
# Rust llama a este contenedor vía ML_SIDECAR_URL (POST /ml/landmarks|fit|texture).
# Base devel (no runtime): pytorch3d se compila desde source y sin nvcc queda
# solo-CPU -> `_C.rasterize_meshes` falla "Not compiled with GPU support" en
# /ml/flame. Con devel el build tarda mas pero el rasterizador CUDA funciona.
FROM nvidia/cuda:12.6.0-devel-ubuntu22.04
# Sin PIP_NO_CACHE_DIR: los RUN de pip usan mount de cache BuildKit (no queda
# en la imagen final) para no re-descargar torch en cada build.
ENV PYTHONUNBUFFERED=1
WORKDIR /work
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip curl libgl1 libglib2.0-0 git build-essential python3-dev ninja-build && rm -rf /var/lib/apt/lists/*
# Modal invoca `python` en sus probes: la imagen CUDA solo trae `python3`.
RUN ln -sf /usr/bin/python3 /usr/bin/python && python --version
COPY requirements.txt ./
# Pesos (nunca en repo ni en imagen): viven en volumen /weights en prod
# (Modal Volume vultus-weights) y en WEIGHTS_DIR local. Receta versionada:
#   sdv1-5 trimmed (unet+vae+text_encoder .bin, sin .ckpt/safety_checker/dups)
#   image_encoder_l trimmed (pytorch_model.bin + tokenizer, sin flax/tf/safetensors)
#   freeuv-checkpoints (2 .bin), deca (tar+resnet50), flame (Open+pkl+masks+npz),
#   mediapipe (face_landmarker.task), freeuv-resources (uv.jpg),
#   deca-code (decalib+data), freeuv-code (detail_encoder+pipeline_sd15).
#   gnm-fitter (pesos + licencia pendientes Step 4; hasta entonces dobles).
# Fase deploy-real-models: torch/diffusers reales pineados arriba; el build
# instala primero torch cu126 y luego el resto desde PyPI.
# Cache mount BuildKit en vez de --no-cache-dir (no queda en la imagen).
# RUNs separados a proposito para granularidad de capas: torch cambia poco,
# requirements mas a menudo.
# hadolint ignore=DL3042,DL3059
RUN --mount=type=cache,target=/root/.cache/pip pip3 install torch==2.13.0 torchvision==0.28.0 --index-url https://download.pytorch.org/whl/cu126
# hadolint ignore=DL3042,DL3059
RUN --mount=type=cache,target=/root/.cache/pip pip3 install -r requirements.txt
# pytorch3d para DECA renderer: sin wheel oficial para cu126/torch 2.13
# (solo hasta pyt241), se compila desde source contra el torch instalado
# (verificado: pytorch3d 0.7.9 compila ok en ~9min). Fallback tolerante:
# en local/doubles no se usa (dobles deterministas sin DECA); si la
# compilacion fallara, el _deca_model falla ruidoso (500 con causa) en
# real, nunca doble silencioso.
# Cache mount en vez de --no-cache-dir; fvcore/iopath sin pin es
# pre-existente (solo warning, no falla el CI).
# hadolint ignore=DL3042,DL3013
RUN --mount=type=cache,target=/root/.cache/pip pip3 install fvcore iopath; pip3 install --no-build-isolation git+https://github.com/facebookresearch/pytorch3d.git || echo "pytorch3d opcional omitido: sin wheel torch2.13/cu126 (deuda prod-GPU)"
# Codigo al final: los cambios de codigo no invalidan las capas pesadas de pip.
# Layout paquete (paridad con Dockerfile.runner): los delegados /ml/fit|texture
# importan backend.domain/gnm_fit/gnm_texture/pipeline_local; en plano
# moririan con ModuleNotFoundError aunque local pasen.
COPY backend/__init__.py ./backend/__init__.py
COPY backend/domain.py ./backend/domain.py
COPY backend/gnm.py ./backend/gnm.py
COPY backend/gnm_fit.py ./backend/gnm_fit.py
COPY backend/gnm_texture.py ./backend/gnm_texture.py
COPY backend/gnm_assemble.py ./backend/gnm_assemble.py
COPY backend/pipeline_local.py ./backend/pipeline_local.py
COPY backend/modal_app.py ./backend/modal_app.py
ENV ML_PORT=8081 WEIGHTS_DIR=/weights
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD python3 -c "import os,urllib.request; p=os.environ.get('ML_PORT','8081'); urllib.request.urlopen(f'http://localhost:{p}/docs')" || exit 1
CMD ["sh", "-c", "python3 -m backend.modal_app --serve :${ML_PORT:-8081}"]
