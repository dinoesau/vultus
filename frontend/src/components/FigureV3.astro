---
// Isla presentacional: figura v3 (malla densa + albedo 1024 + 3 relights).
// Sin lógica de red aquí; el wiring vive en el script de index.astro.
// Track paralelo al zip-6 forense: testids propios, sin compartir paneles.
---

<section aria-label="Figura v3 densa" class="panel">
  <h2>Figura v3</h2>
  <div class="viewers">
    <figure>
      <figcaption>Albedo 1024</figcaption>
      <img
        data-testid="panel-v3-albedo"
        alt="Albedo denso 1024 de la figura v3"
        hidden
      />
      <p class="placeholder">pendiente de figura</p>
    </figure>
    <figure>
      <figcaption>Neutral</figcaption>
      <img
        data-testid="panel-v3-neutral"
        alt="Re-iluminación neutral de la figura v3"
        hidden
      />
      <p class="placeholder">pendiente de figura</p>
    </figure>
    <figure>
      <figcaption>Key</figcaption>
      <img
        data-testid="panel-v3-key"
        alt="Re-iluminación key de la figura v3"
        hidden
      />
      <p class="placeholder">pendiente de figura</p>
    </figure>
    <figure>
      <figcaption>Fill</figcaption>
      <img
        data-testid="panel-v3-fill"
        alt="Re-iluminación fill de la figura v3"
        hidden
      />
      <p class="placeholder">pendiente de figura</p>
    </figure>
    <figure>
      <figcaption>Rim</figcaption>
      <img
        data-testid="panel-v3-rim"
        alt="Re-iluminación rim de la figura v3"
        hidden
      />
      <p class="placeholder">pendiente de figura</p>
    </figure>
  </div>
  <p class="download-row">
    <a id="download-figure-v3" hidden download="">Descargar malla densa</a>
  </p>
  <p id="figure-v3-note" role="status">figura v3 no disponible</p>
</section>

<style>
  .panel {
    background: #fff;
    border: 1px solid #d7dde5;
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin-top: 1.25rem;
  }
  .panel h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #8a5a2b;
    margin: 0 0 0.75rem;
  }
  .viewers {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }
  @media (max-width: 960px) {
    .viewers {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .viewers {
      grid-template-columns: 1fr;
    }
  }
  figure {
    margin: 0;
    border: 1px solid #d7dde5;
    border-radius: 8px;
    overflow: hidden;
  }
  figcaption {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    background: #14202e;
    color: #f4f6f8;
  }
  figure img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    background: #ffffff;
  }
  figure img[hidden] {
    display: none;
  }
  .placeholder {
    font-size: 0.85rem;
    color: #6b7684;
    padding: 0.5rem 0.75rem;
    margin: 0;
  }
  .download-row {
    margin: 1rem 0 0;
  }
  #download-figure-v3 {
    display: inline-block;
    background: #c2410c;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
  }
  #download-figure-v3[hidden] {
    display: none;
  }
  #figure-v3-note {
    font-size: 0.85rem;
    color: #6b7684;
  }
</style>
