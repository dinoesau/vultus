---
// Isla 3D: visor estudio blanco con dos caras PBR (A + B en paralelo).
// Sin SSR pesado: los canvas existen en HTML estatico; Three.js se importa
// lazy solo en cliente (tras mount y tras done via evento `vultus:meshes`).
// Fondo, luces y mensajes provienen del nucleo `three-rig.ts` (sin three).
// Presentacion dark (surface-dark-elevated) para vivir dentro del darkband.
---

<div class="mock-inner">
  <h4>Meshes A / B — giro lento frontal</h4>
  <p class="hint">GLB conserva SkinPBR + EyePBR embebidos. Fallback procedural si llega sin material.</p>
  <div class="viewers2">
    <figure class="fig">
      <figcaption>CARA A <i>mesh_a.glb</i></figcaption>
      <div class="stage">
        <canvas
          data-testid="viewer-3d-a"
          width="480"
          height="360"
          aria-label="Mesh 3D de la cara A con piel PBR"
        >
        </canvas>
        <canvas
          data-testid="viewer-neutral-a"
          width="480"
          height="360"
          aria-hidden="true"
        >
        </canvas>
      </div>
    </figure>
    <figure class="fig">
      <figcaption>CARA B <i>mesh_b.glb</i></figcaption>
      <div class="stage">
        <canvas
          data-testid="viewer-3d-b"
          width="480"
          height="360"
          aria-label="Mesh 3D de la cara B con piel PBR"
        >
        </canvas>
        <canvas
          data-testid="viewer-neutral-b"
          width="480"
          height="360"
          aria-hidden="true"
        >
        </canvas>
      </div>
    </figure>
  </div>
  <p id="viewer-3d-status" role="status">visor 3D listo (neutro, sin resultado)</p>
  <p class="download-row">
    <a id="download-mesh-a" hidden download="mesh_a.glb">Descargar mesh A</a>
    <a id="download-mesh-b" hidden download="mesh_b.glb">Descargar mesh B</a>
  </p>
</div>

<script>
  import {
    LIGHT_PROBES,
    SKIN_MATERIAL,
    STUDIO_BACKGROUND_HEX,
    STUDIO_CANVAS_HEIGHT,
    STUDIO_CANVAS_WIDTH,
    STUDIO_CAMERA_FOV,
    STUDIO_LIGHTS,
    checkLightProbes,
    checkStudioLights,
    describeErrorCause,
    isStaleGen,
    parseGenToken,
    parseStudioBackground,
    resolveSkinColorHex,
    viewerCancelledMessage,
    viewerErrorStatus,
    viewerParseErrorMessage,
    viewerStatusMessage,
    viewerWebglErrorMessage,
  } from "./three-rig.ts";
  import type { Result, ViewerFace, ViewerLoadError, ViewerWebglPhase } from "./three-rig.ts";

  function isRecord(raw: unknown): raw is Record<string, unknown> {
    return typeof raw === "object" && raw !== null && !Array.isArray(raw);
  }

  function isBlob(value: unknown): value is Blob {
    return value instanceof Blob;
  }

  const foundA = document.querySelector('[data-testid="viewer-3d-a"]');
  const canvasA = foundA instanceof HTMLCanvasElement ? foundA : null;
  const foundB = document.querySelector('[data-testid="viewer-3d-b"]');
  const canvasB = foundB instanceof HTMLCanvasElement ? foundB : null;
  // Overlay 2D dedicado al neutro: el unico canvas que recibe
  // getContext("2d"). Los canvas viewer-3d-* son WebGL dedicados y nunca
  // se les pide un contexto 2D (Story-177: evita el lock de tipo de
  // contexto que rompia WebGLRenderer tras el neutro).
  const foundNeutralA = document.querySelector('[data-testid="viewer-neutral-a"]');
  const neutralA = foundNeutralA instanceof HTMLCanvasElement ? foundNeutralA : null;
  const foundNeutralB = document.querySelector('[data-testid="viewer-neutral-b"]');
  const neutralB = foundNeutralB instanceof HTMLCanvasElement ? foundNeutralB : null;
  const statusEl = document.getElementById("viewer-3d-status");
  const foundLinkA = document.getElementById("download-mesh-a");
  const linkA = foundLinkA instanceof HTMLAnchorElement ? foundLinkA : null;
  const foundLinkB = document.getElementById("download-mesh-b");
  const linkB = foundLinkB instanceof HTMLAnchorElement ? foundLinkB : null;
  let meshUrls: string[] = [];
  // S5 (story-178): carrera clear-vs-load. loadSerial cuenta cargas
  // aceptadas; invalidationSerial se bumppea en cada vultus:clear. Un fallo
  // que resuelve tras un clear es CancelledError (fetch revocado), nunca
  // invalid; un fallo de una carga vieja con carga nueva vigente es
  // StaleLoad (silencio). viewerGen espeja la gen de index.astro.
  let viewerGen: number | null = null;
  let loadSerial = 0;
  let invalidationSerial = 0;

  function setStatus(msg: string): void {
    if (statusEl) statusEl.textContent = msg;
  }

  // Contexto 3D perdido con GLB ya parseado: visor no disponible
  // (WebGL), nunca "GLB invalido". Solo dispara con contexto GL vivo,
  // asi que el neutro 2D no lo toca.
  for (const canvas of [canvasA, canvasB]) {
    canvas?.addEventListener("webglcontextlost", (ev) => {
      ev.preventDefault();
      setStatus(viewerStatusMessage("unavailable"));
    });
  }

  // Un solo renderer por canvas: se dispone + cancela RAF antes de repintar.
  interface CanvasSlot {
    renderer: import("three").WebGLRenderer | undefined;
    raf: number | undefined;
  }
  const slots = new Map<HTMLCanvasElement, CanvasSlot>();

  function getSlot(canvas: HTMLCanvasElement): CanvasSlot {
    const found = slots.get(canvas);
    if (found) return found;
    const fresh: CanvasSlot = { renderer: undefined, raf: undefined };
    slots.set(canvas, fresh);
    return fresh;
  }

  function disposeCanvas(canvas: HTMLCanvasElement | null): void {
    if (!canvas) return;
    const slot = slots.get(canvas);
    if (!slot) return;
    if (slot.raf !== undefined) {
      cancelAnimationFrame(slot.raf);
      slot.raf = undefined;
    }
    if (slot.renderer !== undefined) {
      try {
        slot.renderer.dispose();
      } catch {
        // Dispose best-effort: el contexto ya puede estar perdido.
      }
      slot.renderer = undefined;
    }
  }

  // Parsers muertos cableados al boot: sin trio valido no hay visor.
  function studioBootOk(): boolean {
    if (!parseStudioBackground(STUDIO_BACKGROUND_HEX).ok) {
      setStatus("visor 3D no disponible (config estudio)");
      return false;
    }
    if (!checkStudioLights(STUDIO_LIGHTS).ok) {
      setStatus("visor 3D no disponible (config estudio)");
      return false;
    }
    if (!checkLightProbes(LIGHT_PROBES).ok) {
      setStatus("visor 3D no disponible (config estudio)");
      return false;
    }
    return true;
  }

  type ThreeModule = typeof import("three");

  function applyStudio(THREE: ThreeModule, scene: import("three").Scene): void {
    scene.background = new THREE.Color(STUDIO_BACKGROUND_HEX);
    for (const light of STUDIO_LIGHTS) {
      const dir = new THREE.DirectionalLight(light.colorHex, light.intensity);
      dir.position.set(light.position[0], light.position[1], light.position[2]);
      scene.add(dir);
    }
  }

  // Sondas de luz estilo paper: esferas metalicas que reflejan el estudio.
  // Entorno via RoomEnvironment (PMREM, sin HDR externo): sin el, el metal
  // sale negro y las sondas no dicen nada.
  async function applyProbes(
    THREE: ThreeModule,
    scene: import("three").Scene,
    renderer: import("three").WebGLRenderer,
  ): Promise<void> {
    const { RoomEnvironment } = await import("three/examples/jsm/environments/RoomEnvironment.js");
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
    pmrem.dispose();
    for (const probe of LIGHT_PROBES) {
      const geo = new THREE.SphereGeometry(probe.radius, 48, 32);
      const mat = new THREE.MeshStandardMaterial({
        color: 0xffffff,
        metalness: probe.metalness,
        roughness: probe.roughness,
      });
      const ball = new THREE.Mesh(geo, mat);
      ball.position.set(probe.position[0], probe.position[1], probe.position[2]);
      ball.name = `VultusProbe-${probe.name}`;
      scene.add(ball);
    }
  }

  function makeCamera(THREE: ThreeModule): import("three").PerspectiveCamera {
    const camera = new THREE.PerspectiveCamera(
      STUDIO_CAMERA_FOV,
      STUDIO_CANVAS_WIDTH / STUDIO_CANVAS_HEIGHT,
      0.1,
      100,
    );
    camera.position.set(0, 0.2, 3.2);
    camera.lookAt(0, 0, 0);
    return camera;
  }

  function skinMaterial(THREE: ThreeModule): import("three").MeshStandardMaterial {
    return new THREE.MeshStandardMaterial({
      color: resolveSkinColorHex(false),
      roughness: SKIN_MATERIAL.roughness,
      metalness: SKIN_MATERIAL.metalness,
    });
  }

  // Render neutro identico al PoC vultus-01: mock 2D oscuro (fondo de
  // tarjeta, elipse crema + offset coral + filete claro). Espera
  // presentacional; el 3D real (three.js + estudio blanco) solo entra
  // con GLBs tras done. Sin three.js en este path.
  // Story-177: `canvas` SIEMPRE es un overlay neutro dedicado
  // (viewer-neutral-a/b). Nunca pasar un canvas viewer-3d-*: su primer
  // getContext debe ser WebGL o el renderer lanza por tipo de contexto.
  function renderNeutral(canvas: HTMLCanvasElement | null): void {
    if (!canvas) return;
    disposeCanvas(canvas);
    const ctx = canvas.getContext("2d");
    if (!ctx) {
      setStatus("visor 3D no disponible (canvas 2D)");
      return;
    }
    const W = canvas.width || 480;
    const H = canvas.height || 360;
    const sx = W / 480;
    const sy = H / 360;
    const other = canvas === neutralB ? 1 : 0;
    let t = 0;
    const tick = () => {
      t += 0.02;
      const tt = t + other;
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = "#1f1e1b";
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = "#f5f0e8";
      ctx.beginPath();
      ctx.ellipse(
        240 * sx,
        180 * sy,
        (95 + Math.sin(tt) * 6) * sx,
        125 * sy,
        Math.sin(tt * 2) * 0.15,
        0,
        7,
      );
      ctx.fill();
      ctx.fillStyle = "rgba(204,120,92,.35)";
      ctx.beginPath();
      ctx.ellipse(240 * sx + Math.sin(t) * 30 * sx, 180 * sy, 95 * sx, 125 * sy, 0, 0, 7);
      ctx.fill();
      ctx.strokeStyle = "rgba(250,249,245,.25)";
      ctx.stroke();
      if (canvas.isConnected) {
        getSlot(canvas).raf = requestAnimationFrame(tick);
      }
    };
    tick();
  }

  function trackUrl(url: string): void {
    meshUrls.push(url);
  }

  interface ViewerDetail {
    readonly meshA: Blob;
    readonly meshB: Blob;
    readonly pbrA?: Blob;
    readonly pbrB?: Blob;
    // Token de generacion del job (espejo de la gen de index.astro):
    // unknown en el borde, se parsea con parseGenToken, nunca cast.
    readonly gen?: unknown;
  }

  type ViewerDetailError = { readonly kind: "InvalidViewerDetail" };

  // Parse propio Result: sin casts fuera del dominio, detalle roto es Err.
  // Construccion inmutable: el valor se crea en una sola expresion, sin reasignacion.
  function parseViewerDetail(raw: unknown): Result<ViewerDetail, ViewerDetailError> {
    if (!isRecord(raw)) return { ok: false, error: { kind: "InvalidViewerDetail" } };
    const meshA = raw["meshA"];
    const meshB = raw["meshB"];
    if (!isBlob(meshA) || !isBlob(meshB)) {
      return { ok: false, error: { kind: "InvalidViewerDetail" } };
    }
    const pbrA = raw["pbrA"];
    const pbrB = raw["pbrB"];
    if (pbrA !== undefined && !isBlob(pbrA)) {
      return { ok: false, error: { kind: "InvalidViewerDetail" } };
    }
    if (pbrB !== undefined && !isBlob(pbrB)) {
      return { ok: false, error: { kind: "InvalidViewerDetail" } };
    }
    return {
      ok: true,
      value: {
        meshA,
        meshB,
        ...(isBlob(pbrA) ? { pbrA } : {}),
        ...(isBlob(pbrB) ? { pbrB } : {}),
        ...(raw["gen"] !== undefined ? { gen: raw["gen"] } : {}),
      },
    };
  }

  // Total: detalle roto es Err y el caller lo mapea a status invalid, nunca drop silencioso.
  function readDetail(ev: Event): Result<ViewerDetail, ViewerDetailError> {
    if (!isRecord(ev)) return { ok: false, error: { kind: "InvalidViewerDetail" } };
    return parseViewerDetail(ev["detail"]);
  }

  // Guarda de tipo para el catch de loadGlbs: paintFace solo rechaza
  // con ViewerLoadError, pero el borde es unknown y no se asume nada.
  function isViewerLoadError(err: unknown): err is ViewerLoadError {
    if (!isRecord(err)) return false;
    const kind = err["kind"];
    return (
      kind === "ParseError" ||
      kind === "WebGLError" ||
      kind === "CancelledError" ||
      kind === "StaleLoad"
    );
  }

  // Clasifica un fallo post-inicio: stale si una carga nueva ya manda,
  // cancelado si un clear revoco las URLs en vuelo, taxonomia por fase
  // en caso contrario. Total: nunca lanza.
  function afterStartError(
    face: ViewerFace,
    phase: "parse" | ViewerWebglPhase,
    err: unknown,
    myLoad: number,
    myInvalid: number,
  ): ViewerLoadError {
    if (myLoad !== loadSerial) return { kind: "StaleLoad" };
    if (myInvalid !== invalidationSerial) return { kind: "CancelledError" };
    const cause = describeErrorCause(err);
    if (phase === "parse") {
      return { kind: "ParseError", face, phase, name: cause.name, message: cause.message };
    }
    return { kind: "WebGLError", face, phase, name: cause.name, message: cause.message };
  }

  // Tras done: expone re-descarga local e intenta pintar las caras reales.
  // El neutro procedural es solo carga; el exito exige GLBs parseados.
  window.addEventListener("vultus:meshes", (ev) => {
    const parsed = readDetail(ev);
    if (!parsed.ok) {
      setStatus(viewerStatusMessage("invalid"));
      return;
    }
    const detail = parsed.value;
    // Gen vieja con reintento vigente: se ignora en silencio, sin tocar status.
    const incomingGen = parseGenToken(detail.gen ?? null);
    if (isStaleGen(incomingGen, viewerGen)) return;
    if (incomingGen !== null) viewerGen = incomingGen;
    const urlA = URL.createObjectURL(detail.meshA);
    const urlB = URL.createObjectURL(detail.meshB);
    trackUrl(urlA);
    trackUrl(urlB);
    const pbrUrlA = detail.pbrA ? URL.createObjectURL(detail.pbrA) : null;
    const pbrUrlB = detail.pbrB ? URL.createObjectURL(detail.pbrB) : null;
    if (pbrUrlA) trackUrl(pbrUrlA);
    if (pbrUrlB) trackUrl(pbrUrlB);
    if (linkA) {
      linkA.href = urlA;
      linkA.hidden = false;
    }
    if (linkB) {
      linkB.href = urlB;
      linkB.hidden = false;
    }
    setStatus(viewerStatusMessage("loading"));
    const myLoad = ++loadSerial;
    const myInvalid = invalidationSerial;
    void loadGlbs(urlA, urlB, pbrUrlA, pbrUrlB, myLoad, myInvalid);
  });

  async function paintFace(
    THREE: ThreeModule,
    canvas: HTMLCanvasElement,
    neutral: HTMLCanvasElement | null,
    glbUrl: string,
    pbrUrl: string | null,
    face: ViewerFace,
    myLoad: number,
    myInvalid: number,
  ): Promise<{ readonly pbrOk: boolean }> {
    // Yaw inicial frontal: la cara del GLB apunta a -Z y la camara
    // (0,0.2,3.2) mira al origen desde +Z; PI la frontaliza en el primer
    // frame. Giro lento conservado (tick 240 frames).
    const FRONT_YAW: number = Math.PI;
    const { GLTFLoader } = await import("three/examples/jsm/loaders/GLTFLoader.js");
    const loader = new GLTFLoader();
    // Fase parse: el unico fallo que puede culpar al zip.
    let model: import("three").Group;
    try {
      model = (await loader.loadAsync(glbUrl)).scene;
    } catch (err) {
      throw afterStartError(face, "parse", err, myLoad, myInvalid);
    }
    // Clear entre parse y render: la carga ya esta muerta, no hay GLB que pintar.
    if (myLoad !== loadSerial) {
      const stale: ViewerLoadError = { kind: "StaleLoad" };
      throw stale;
    }
    if (myInvalid !== invalidationSerial) {
      const cancelled: ViewerLoadError = { kind: "CancelledError" };
      throw cancelled;
    }
    let map: import("three").Texture | null = null;
    if (pbrUrl) {
      try {
        const texLoader = new THREE.TextureLoader();
        const tex = await texLoader.loadAsync(pbrUrl);
        tex.colorSpace = THREE.SRGBColorSpace;
        // Convencion V unica con el GLB (spec-correcto, chin v≈1):
        // el overlay PBR usa las mismas UVs, asi que flipY=false como GLTFLoader.
        tex.flipY = false;
        map = tex;
      } catch {
        map = null;
      }
    }
    const pbrOk = map !== null;
    // GLB conserva materiales embebidos tal cual (primitiva 0 SkinPBR material 0,
    // primitiva 1 EyePBR material 1 con texturas propias).
    // Fallback solo si el mesh llega sin material (GLB minimo sin material estandar).
    const fallback = skinMaterial(THREE);
    if (map) {
      fallback.map = map;
      fallback.color.set(resolveSkinColorHex(true));
    }
    // Ojos preservados por indice de material/primitiva: no se toca ningun
    // material existente, sin filtro por nombre de nodo.
    model.traverse((node) => {
      if (!(node instanceof THREE.Mesh)) return;
      const current = node.material;
      if (Array.isArray(current)) {
        if (current.length === 0) {
          node.material = fallback;
          return;
        }
        let hasGap = false;
        for (const entry of current) {
          if (!entry) {
            hasGap = true;
            break;
          }
        }
        if (!hasGap) return;
        node.material = current.map((entry) => (entry ? entry : fallback));
        return;
      }
      if (current) return;
      node.material = fallback;
    });
    // Fases WebGL con GLB ya parseado: cualquier fallo aqui es visor no
    // disponible, nunca GLB invalido. Cada fase lleva su nombre al log.
    disposeCanvas(canvas);
    // El overlay neutro ya cumplio: se cancela su RAF y se oculta para
    // revelar el canvas WebGL dedicado, que nunca recibio getContext("2d").
    disposeCanvas(neutral);
    if (neutral) neutral.hidden = true;
    let renderer: import("three").WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    } catch (err) {
      throw afterStartError(face, "renderer", err, myLoad, myInvalid);
    }
    renderer.setSize(STUDIO_CANVAS_WIDTH, STUDIO_CANVAS_HEIGHT, false);
    getSlot(canvas).renderer = renderer;
    const scene = new THREE.Scene();
    applyStudio(THREE, scene);
    const camera = makeCamera(THREE);
    model.rotation.y = FRONT_YAW;
    scene.add(model);
    try {
      await applyProbes(THREE, scene, renderer);
    } catch (err) {
      throw afterStartError(face, "probes", err, myLoad, myInvalid);
    }
    try {
      renderer.render(scene, camera);
    } catch (err) {
      throw afterStartError(face, "render", err, myLoad, myInvalid);
    }
    let frames = 0;
    const tick = () => {
      model.rotation.y += 0.01;
      renderer.render(scene, camera);
      if (++frames < 240 && canvas.isConnected) {
        getSlot(canvas).raf = requestAnimationFrame(tick);
      }
    };
    tick();
    return { pbrOk };
  }

  async function loadGlbs(
    urlA: string,
    urlB: string,
    pbrA: string | null,
    pbrB: string | null,
    myLoad: number,
    myInvalid: number,
  ): Promise<void> {
    if (!canvasA || !canvasB) return;
    // El chunk three.js es infra del visor: si no carga, no hay GLB
    // que culpar; es visor no disponible, nunca invalid.
    let THREE: ThreeModule;
    try {
      THREE = await import("three");
    } catch {
      if (myLoad !== loadSerial) return;
      setStatus(viewerStatusMessage("unavailable"));
      return;
    }
    try {
      // Exito solo si ambos GLB parsean; cada cara se pinta en su canvas
      // WebGL dedicado con su overlay neutro asociado.
      // PBR roto nunca es ready: estado distinto sin PBR, GLB parseado.
      const [doneA, doneB] = await Promise.all([
        paintFace(THREE, canvasA, neutralA, urlA, pbrA, "A", myLoad, myInvalid),
        paintFace(THREE, canvasB, neutralB, urlB, pbrB, "B", myLoad, myInvalid),
      ]);
      // Reintento nuevo vigente: el exito viejo no pisa su loading.
      if (myLoad !== loadSerial) return;
      // Clear en vuelo sin reintento: la carga murio revocada.
      if (myInvalid !== invalidationSerial) {
        setStatus(viewerCancelledMessage());
        return;
      }
      if (!doneA.pbrOk || !doneB.pbrOk) {
        setStatus(`${viewerStatusMessage("loading")} sin PBR (textura no disponible, GLB parseado).`);
        return;
      }
      setStatus(viewerStatusMessage("ready"));
    } catch (err) {
      // Reintento nuevo vigente: el fallo viejo se ignora en silencio.
      if (myLoad !== loadSerial) return;
      const mapped: ViewerLoadError = isViewerLoadError(err)
        ? err
        : {
            kind: "WebGLError",
            face: "A",
            phase: "render",
            ...describeErrorCause(err),
          };
      // Clear en vuelo: el fetch del blob revocado falla como cancelada
      // aunque el error parezca de parse. Nunca invalid tras un clear.
      const effective: ViewerLoadError =
        mapped.kind === "StaleLoad" || myInvalid === invalidationSerial
          ? mapped
          : { kind: "CancelledError" };
      const status = viewerErrorStatus(effective);
      if (status === null) return;
      if (status === "invalid" && effective.kind === "ParseError") {
        setStatus(viewerParseErrorMessage(effective.face, effective));
        return;
      }
      if (status === "unavailable" && effective.kind === "WebGLError") {
        setStatus(viewerWebglErrorMessage(effective.face, effective.phase, effective));
        return;
      }
      setStatus(viewerStatusMessage(status));
    }
  }

  window.addEventListener("vultus:clear", () => {
    // Invalida primero: cualquier loadAsync en vuelo que resuelva despues
    // es CancelledError, no invalid (Race Hazard del revoke abajo).
    invalidationSerial += 1;
    for (const u of meshUrls) URL.revokeObjectURL(u);
    meshUrls = [];
    if (linkA) {
      linkA.hidden = true;
      linkA.removeAttribute("href");
    }
    if (linkB) {
      linkB.hidden = true;
      linkB.removeAttribute("href");
    }
    disposeCanvas(canvasA);
    disposeCanvas(canvasB);
    disposeCanvas(neutralA);
    disposeCanvas(neutralB);
    // El overlay neutro vuelve a tapar el WebGL tras limpiar.
    if (neutralA) neutralA.hidden = false;
    if (neutralB) neutralB.hidden = false;
    setStatus(viewerStatusMessage("idle"));
    if (studioBootOk()) {
      void renderNeutral(neutralA);
      void renderNeutral(neutralB);
    }
  });

  if (studioBootOk()) {
    void renderNeutral(neutralA);
    void renderNeutral(neutralB);
  }
</script>

<style>
  .mock-inner h4 {
    margin: 0 0 4px;
    font-family: Inter, sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--on-dark, #faf9f5);
  }
  .mock-inner .hint {
    font-size: 13px;
    color: var(--on-dark-soft, #a09d96);
    margin: 0 0 14px;
  }
  .viewers2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 640px) {
    .viewers2 {
      grid-template-columns: 1fr;
    }
  }
  .fig {
    margin: 0;
    border: 1px solid #33302b;
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface-dark-soft, #1f1e1b);
