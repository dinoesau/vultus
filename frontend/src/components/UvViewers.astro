---
// Isla presentacional UV-only: dos paneles canonicos.
// Sin logica de red; el wiring (progreso + zip + 3D via evento)
// vive en pages/index.astro. Sin PBR/renders/heatmap aqui.
---

<div class="uvband">
  <div class="uvcard">
    <h3>UV A canónico</h3>
    <p>Albedo con piel total · frontal normalizado</p>
    <figure>
      <figcaption>uv_a.png</figcaption>
      <img data-testid="panel-uv-a" alt="Mapa UV canónico de la cara A" hidden />
      <p class="placeholder" data-pl-uv-a>pendiente de resultado</p>
    </figure>
  </div>
  <div class="uvcard">
    <h3>UV B canónico</h3>
    <p>Mismo atlas, misma pose neutra</p>
    <figure>
      <figcaption>uv_b.png</figcaption>
      <img data-testid="panel-uv-b" alt="Mapa UV canónico de la cara B" hidden />
      <p class="placeholder" data-pl-uv-b>pendiente de resultado</p>
    </figure>
  </div>
</div>

<style>
  .uvband {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 640px) {
    .uvband {
      grid-template-columns: 1fr;
    }
  }
  .uvcard {
    background: var(--canvas, #faf9f5);
    border: 1px solid var(--hairline, #e6dfd8);
    border-radius: 12px;
    padding: 20px;
  }
  .uvcard h3 {
    font-family: "Cormorant Garamond", Tiempos Headline, Garamond, serif;
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--ink, #141413);
    margin: 0 0 4px;
  }
  .uvcard p {
    font-size: 14px;
    color: var(--muted, #6c6a64);
    margin: 0 0 14px;
  }
  .uvcard figure {
    margin: 0;
    border: 1px solid var(--hairline, #e6dfd8);
    border-radius: 8px;
    overflow: hidden;
  }
  .uvcard figcaption {
    font-size: 13px;
    font-weight: 600;
    padding: 8px 12px;
    background: var(--ink, #141413);
    color: #f4f6f8;
  }
  .uvcard img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    background: #ffffff;
  }
  .uvcard img[hidden] {
    display: none;
  }
  .uvcard .placeholder {
    font-size: 14px;
    color: var(--muted, #6c6a64);
    padding: 18px;
    margin: 0;
    text-align: center;
    background: var(--surface-soft, #f5f0e8);
  }
  .uvcard .placeholder[hidden] {
    display: none;
  }
</style>
