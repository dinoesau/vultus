---
import ThreeViewer from "../components/ThreeViewer.astro";
import UvViewers from "../components/UvViewers.astro";
import FigureV3 from "../components/FigureV3.astro";

const apiUrl = import.meta.env.VITE_API_URL ?? "http://localhost:8000";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Vultus - Comparador facial forense</title>
    <style>
      :root {
        color-scheme: light;
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 1080px;
        margin: 2rem auto;
        padding: 0 1rem 3rem;
        background: #eef1f4;
        color: #1c1917;
      }
      form {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
        background: #fff;
        border: 1px solid #d7dde5;
        border-radius: 10px;
        padding: 1rem 1.25rem;
      }
      @media (max-width: 560px) {
        form {
          grid-template-columns: 1fr;
        }
      }
      .input-panel {
        display: grid;
        gap: 0.5rem;
        align-content: start;
        border: 1px solid #d7dde5;
        border-radius: 8px;
        padding: 0.75rem;
      }
      .input-panel img {
        display: block;
        width: 100%;
        aspect-ratio: 1;
        object-fit: contain;
        background: #ffffff;
        border-radius: 6px;
      }
      .input-panel img[hidden] {
        display: none;
      }
      .input-panel .placeholder {
        font-size: 0.85rem;
        color: #6b7684;
        margin: 0;
      }
      form button {
        grid-column: 1 / -1;
        justify-self: start;
        background: #1c1917;
        color: #fff;
        font-weight: 700;
        border: 0;
        border-radius: 8px;
        padding: 0.6rem 1.4rem;
        cursor: pointer;
      }
    </style>
  </head>
  <body data-api-url={apiUrl}>
    <header>
      <h1>Vultus - Comparador facial forense</h1>
    </header>
    <form id="compare">
      <div class="input-panel">
        <label>Imagen A <input type="file" name="image_a" accept="image/jpeg,image/png" required /></label>
        <img data-testid="preview-a" alt="Vista previa de la imagen A" hidden />
        <p class="placeholder">sin vista previa A</p>
      </div>
      <div class="input-panel">
        <label>Imagen B <input type="file" name="image_b" accept="image/jpeg,image/png" required /></label>
        <img data-testid="preview-b" alt="Vista previa de la imagen B" hidden />
        <p class="placeholder">sin vista previa B</p>
      </div>
      <button type="submit">Comparar</button>
    </form>
    <UvViewers />
    <ThreeViewer />
    <FigureV3 />
    <script>
      import {
        API_PATHS,
        contractVersionMessage,
        errorDetail,
        isRetryableResultStatus,
        isTerminal,
        parseCompareResponse,
        parseHealthContractVersion,
        parseJobEvent,
        parsePollStatus,
        statusMessage,
        toWsUrl,
        tryExtractV3Blobs,
        tryExtractViewerBlobs,
      } from "../components/compare-client.ts";
      import type { HealthVersionError, Result } from "../components/compare-client.ts";

      const api = document.body.dataset.apiUrl ?? "http://localhost:8000";
      const foundForm = document.getElementById("compare");
      const form = foundForm instanceof HTMLFormElement ? foundForm : null;
      const foundProgress = document.getElementById("job-progress");
      const progressEl = foundProgress instanceof HTMLProgressElement ? foundProgress : null;
      const foundStage = document.getElementById("stage-text");
      const stageEl = foundStage instanceof HTMLElement ? foundStage : null;
      const foundDownload = document.getElementById("download-zip");
      const downloadEl = foundDownload instanceof HTMLAnchorElement ? foundDownload : null;
      const foundError = document.getElementById("result-error");
      const errorEl = foundError instanceof HTMLElement ? foundError : null;

      type PreviewError =
        | { readonly kind: "MissingInput" }
        | { readonly kind: "MissingImage" }
        | { readonly kind: "EmptySelection" };

      const previewUrls = new Map<HTMLImageElement, string>();

      function setStageText(msg: string): void {
        if (stageEl) stageEl.textContent = msg;
      }

      // Total: parse-once del input file a blob: URL. Nunca lanza por input
      // esperado; seleccion vacia o nodos ausentes van por Err.
      function updatePreview(inputEl: unknown, imgEl: unknown): Result<void, PreviewError> {
        if (!(inputEl instanceof HTMLInputElement)) {
          return { ok: false, error: { kind: "MissingInput" } };
        }
        if (!(imgEl instanceof HTMLImageElement)) {
          return { ok: false, error: { kind: "MissingImage" } };
        }
        const files = inputEl.files;
        if (!files || files.length === 0) {
          return { ok: false, error: { kind: "EmptySelection" } };
        }
        const file = files[0];
        if (!(file instanceof File)) {
          return { ok: false, error: { kind: "EmptySelection" } };
        }
        const prev = previewUrls.get(imgEl);
        if (typeof prev === "string") URL.revokeObjectURL(prev);
        const url = URL.createObjectURL(file);
        previewUrls.set(imgEl, url);
        imgEl.src = url;
        imgEl.hidden = false;
        imgEl.closest("div")?.querySelector(".placeholder")?.setAttribute("hidden", "");
        return { ok: true, value: undefined };
      }

      function clearSinglePreview(imgEl: unknown): void {
        if (!(imgEl instanceof HTMLImageElement)) return;
        const prev = previewUrls.get(imgEl);
        if (typeof prev === "string") URL.revokeObjectURL(prev);
        previewUrls.delete(imgEl);
        imgEl.hidden = true;
        imgEl.removeAttribute("src");
        imgEl.closest("div")?.querySelector(".placeholder")?.removeAttribute("hidden");
      }

      function clearPreviews(): void {
        for (const url of previewUrls.values()) URL.revokeObjectURL(url);
        previewUrls.clear();
        for (const selector of ['[data-testid="preview-a"]', '[data-testid="preview-b"]']) {
          const found = document.querySelector(selector);
          if (!(found instanceof HTMLImageElement)) continue;
          found.hidden = true;
          found.removeAttribute("src");
          found.closest("div")?.querySelector(".placeholder")?.removeAttribute("hidden");
        }
      }

      function bindPreview(inputName: string, previewTestId: string): void {
        const foundInput = document.querySelector(inputName);
        const foundImg = document.querySelector(previewTestId);
        if (!(foundInput instanceof HTMLInputElement)) return;
        if (!(foundImg instanceof HTMLImageElement)) return;
        const inputRef = foundInput;
        const imgRef = foundImg;
        inputRef.addEventListener("change", () => {
          const parsed = updatePreview(inputRef, imgRef);
          if (!parsed.ok) clearSinglePreview(imgRef);
        });
      }

      bindPreview('input[name="image_a"]', '[data-testid="preview-a"]');
      bindPreview('input[name="image_b"]', '[data-testid="preview-b"]');

      // Blob URL del zip en memoria: permite re-descarga local sin volver
      // al servidor (cumple stateless + TTL: tras 60s el servidor olvida).
      let zipUrl: string | null = null;
      let imgUrls: string[] = [];
      let pollTimer: number | null = null;
      let ws: WebSocket | null = null;
      let settled = false;
      // Reintento en caliente: último envío + bandera de un solo reintento.
      let lastFd: FormData | null = null;
      let autoRetried = false;
      // Generación del job vivo: cada startJob la incrementa y cada callback
      // asíncrono (WS, polling, fetch) se ignora si ya no es la vigente.
      // Sin esto, el socket/poller del intento anterior pisa la UI del nuevo.
      let gen = 0;

      function setProgress(pct: number): void {
        if (!progressEl) return;
        progressEl.value = pct;
        progressEl.textContent = `${pct}%`;
      }

      function showStage(jobId: string, status: string, stage: string, progress: number): void {
        const pct = Math.round(progress * 100);
        setStageText(`job ${jobId}: ${statusMessage(status, stage, progress, jobId)}`);
        setProgress(pct);
      }

      function showError(msg: string): void {
        if (!errorEl) return;
        errorEl.hidden = false;
        errorEl.textContent = msg;
      }

      // Salud del contrato: mismatch o ilegible muestra actualiza, nunca panel roto.
      // Solo el fallo de red al pedir /health es fail-open con Ok(true): el POST
      // posterior mostrara su error real. Un JSON roto es InvalidHealthVersion y
      // bloquea con mensaje actualiza (nunca fail-open silencioso).
      async function checkContractHealth(): Promise<Result<boolean, HealthVersionError>> {
        let res: Response;
        try {
          res = await fetch(`${api}/health`);
        } catch {
          // Network fail-open: sin red el POST ya mostrara su error.
          return { ok: true, value: true };
        }
        let raw: unknown;
        try {
          raw = await res.json();
        } catch {
          const error: HealthVersionError = { kind: "InvalidHealthVersion" };
          const msg = contractVersionMessage(error);
          showError(msg);
          setStageText(msg);
          return { ok: false, error };
        }
        const parsed = parseHealthContractVersion(raw);
        if (parsed.ok) return { ok: true, value: true };
        const msg = contractVersionMessage(parsed.error);
        showError(msg);
        setStageText(msg);
        return { ok: false, error: parsed.error };
      }

      function clearResult(): void {
        if (zipUrl) URL.revokeObjectURL(zipUrl);
        for (const u of imgUrls) URL.revokeObjectURL(u);
        zipUrl = null;
        imgUrls = [];
        clearPreviews();
        window.dispatchEvent(new Event("vultus:clear"));
        if (downloadEl) {
          downloadEl.hidden = true;
          downloadEl.removeAttribute("href");
        }
        if (errorEl) {
          errorEl.hidden = true;
          errorEl.textContent = "";
        }
        for (const img of document.querySelectorAll<HTMLImageElement>(
          'img[data-testid="panel-uv-a"], img[data-testid="panel-uv-b"], img[data-testid="panel-pbr-a"], img[data-testid="panel-pbr-b"], img[data-testid="panel-render-a"], img[data-testid="panel-render-b"]',
        )) {
          img.hidden = true;
          img.removeAttribute("src");
        }
        for (const p of document.querySelectorAll(".placeholder")) {
          if (p instanceof HTMLElement) p.hidden = false;
        }
      }

      function stopLive(): void {
        settled = true;
        if (pollTimer !== null) {
          window.clearInterval(pollTimer);
          pollTimer = null;
        }
        if (ws) {
          try {
            ws.close();
          } catch {
            // Cierre best-effort: el socket ya puede estar caído.
          }
          ws = null;
        }
      }

      function setImage(selector: string, blob: Blob): void {
        const img = document.querySelector<HTMLImageElement>(selector);
        if (!img) return;
        const url = URL.createObjectURL(blob);
        imgUrls.push(url);
        img.src = url;
        img.hidden = false;
        img.closest("figure")?.querySelector(".placeholder")?.setAttribute("hidden", "");
      }

      async function renderResult(zipBlob: Blob, jobId: string, myGen: number): Promise<void> {
        if (myGen !== gen) return;
        zipUrl = URL.createObjectURL(zipBlob);
        if (downloadEl) {
          downloadEl.href = zipUrl;
          downloadEl.download = `result-${jobId}.zip`;
          downloadEl.textContent = `Descargar zip (result-${jobId}.zip)`;
          downloadEl.hidden = false;
        }
        const parsed = await tryExtractViewerBlobs(zipBlob);
        if (myGen !== gen) return;
        if (!parsed.ok) {
          showError(`job ${jobId}: zip sin piezas (falta ${parsed.error.name}).`);
          return;
        }
        const { uvA, uvB, pbrA, pbrB, meshA, meshB, renderA, renderB } = parsed.value;
        setImage('[data-testid="panel-uv-a"]', uvA);
        setImage('[data-testid="panel-uv-b"]', uvB);
        setImage('[data-testid="panel-pbr-a"]', pbrA);
        setImage('[data-testid="panel-pbr-b"]', pbrB);
        setImage('[data-testid="panel-render-a"]', renderA);
        setImage('[data-testid="panel-render-b"]', renderB);
        window.dispatchEvent(
          new CustomEvent("vultus:meshes", { detail: { meshA, meshB, pbrA, pbrB } }),
        );
        setStageText(`job ${jobId}: listo. Zip guardado en memoria para re-descarga local.`);
        setProgress(100);
        void fetchFigureV3(jobId, myGen);
      }

      // Figura v3 best-effort (track paralelo, sin TTL 60): 404/409 solo
      // anotan "no disponible", nunca error. 200 pinta los 5 paneles.
      async function fetchFigureV3(jobId: string, myGen: number): Promise<void> {
        if (myGen !== gen) return;
        const noteEl = document.getElementById("figure-v3-note");
        const foundMesh = document.getElementById("download-figure-v3");
        const meshEl = foundMesh instanceof HTMLAnchorElement ? foundMesh : null;
        let res: Response;
        try {
          res = await fetch(`${api}${API_PATHS.figureV3(jobId)}`);
        } catch {
          if (noteEl) noteEl.textContent = "figura v3 no disponible (sin conexión)";
          return;
        }
        if (!res.ok) {
          if (noteEl) noteEl.textContent = `figura v3 no disponible (HTTP ${res.status})`;
          return;
        }
        let blob: Blob;
        try {
          blob = await res.blob();
        } catch {
          if (noteEl) noteEl.textContent = "figura v3 no disponible (zip ilegible)";
          return;
        }
        const parsed = await tryExtractV3Blobs(blob);
        if (myGen !== gen) return;
        if (!parsed.ok) {
          if (noteEl) noteEl.textContent = `figura v3 incompleta (falta ${parsed.error.name})`;
          return;
        }
        const { albedo, neutral, key, fill, rim, meshDense } = parsed.value;
        const paint = (selector: string, b: Blob): void => {
          const url = URL.createObjectURL(b);
          imgUrls.push(url);
          const found = document.querySelector(selector);
          if (!(found instanceof HTMLImageElement)) return;
          found.src = url;
          found.hidden = false;
          found.closest("figure")?.querySelector(".placeholder")?.setAttribute("hidden", "");
        };
        paint('[data-testid="panel-v3-albedo"]', albedo);
        paint('[data-testid="panel-v3-neutral"]', neutral);
        paint('[data-testid="panel-v3-key"]', key);
        paint('[data-testid="panel-v3-fill"]', fill);
        paint('[data-testid="panel-v3-rim"]', rim);
        if (meshEl) {
          const meshUrl = URL.createObjectURL(meshDense);
          imgUrls.push(meshUrl);
          meshEl.href = meshUrl;
          meshEl.download = `figure-v3-${jobId}.zip`;
          meshEl.textContent = "Descargar malla densa (mesh_dense.glb)";
          meshEl.hidden = false;
        }
        if (noteEl) noteEl.textContent = `figura v3 lista (job ${jobId})`;
      }

      // Tolerante a 404/409 durante processing: el zip solo existe tras done y
      // el worker puede tardar en exponerlo; reintento acotado 10x1s, sin colgar la UI.
      // 409 = not-yet-done (prod vivo), 404 = zip aun no visible o job purgado.
      async function fetchResult(jobId: string, myGen: number, attempt = 0): Promise<void> {
        if (myGen !== gen) return;
        if (attempt === 0) {
          const healthy = await checkContractHealth();
          if (!healthy.ok) return;
          if (myGen !== gen) return;
        }
        let res: Response;
        try {
          res = await fetch(`${api}${API_PATHS.result(jobId)}`);
        } catch {
          showError(`job ${jobId}: sin conexión al descargar el resultado.`);
          return;
        }
        if (isRetryableResultStatus(res.status) && attempt < 10) {
          const why = res.status === 409 ? "aún procesando (409)" : "aún no disponible (404)";
          setStageText(`job ${jobId}: resultado ${why}, reintentando...`);
          window.setTimeout(() => void fetchResult(jobId, myGen, attempt + 1), 1000);
          return;
        }
        if (!res.ok) {
          showError(`job ${jobId}: no se pudo descargar el resultado (HTTP ${res.status}).`);
          return;
        }
        try {
          await renderResult(await res.blob(), jobId, myGen);
        } catch (err) {
          const why = err instanceof Error ? err.message : String(err);
          showError(`job ${jobId}: zip inválido (${why}).`);
        }
      }

      function onEvent(
        jobId: string,
        status: string,
        progress: number,
        stage: string,
        myGen: number,
      ): void {
        if (settled || myGen !== gen) return;
        // Cadena fría supera el TTL 60s: un solo reintento en caliente,
        // cuando los modelos ya quedaron cargados. Sin loops.
        if (status === "expired" && !autoRetried && lastFd) {
          autoRetried = true;
          stopLive();
          settled = false;
          clearResult();
          setStageText(`job ${jobId}: expiró en frío (TTL 60s). Reintentando en caliente...`);
          void startJob(lastFd);
          return;
        }
        showStage(jobId, status, stage, progress);
        if (!isTerminal(status)) return;
        stopLive();
        if (status === "done") void fetchResult(jobId, myGen);
      }

      // Fallback a polling 1s si el WS falla o cierra antes de un estado
      // terminal. GET status solo da {job_id, status}: sin etapa/progreso.
      function startPolling(jobId: string, myGen: number): void {
        if (pollTimer !== null || settled) return;
        const tick = async () => {
          if (myGen !== gen) {
            if (pollTimer !== null) {
              window.clearInterval(pollTimer);
              pollTimer = null;
            }
            return;
          }
          let res: Response;
          try {
            res = await fetch(`${api}${API_PATHS.job(jobId)}`);
          } catch {
            return;
          }
          if (res.status === 404) {
            stopLive();
            setStageText(`job ${jobId}: no encontrado (404).`);
            return;
          }
          if (!res.ok) return;
          let pollBody: unknown;
          try {
            pollBody = await res.json();
          } catch {
            return;
          }
          const poll = parsePollStatus(pollBody);
          if (!poll.ok) return;
          const body = { status: poll.value };
          if (body.status === "done") {
            stopLive();
            setStageText(`job ${jobId}: listo. Descargando resultado...`);
            setProgress(100);
            void fetchResult(jobId, myGen);
          } else if (isTerminal(body.status)) {
            onEvent(jobId, body.status, body.status === "failed" ? 0 : 1, "?", myGen);
          } else {
            setStageText(`job ${jobId}: ${body.status} (polling, sin WS)...`);
          }
        };
        pollTimer = window.setInterval(() => void tick(), 1000);
        void tick();
      }

      function subscribe(jobId: string, myGen: number): void {
        let socket: WebSocket;
        try {
          socket = new WebSocket(toWsUrl(api, jobId));
        } catch {
          startPolling(jobId, myGen);
          return;
        }
        ws = socket;
        socket.addEventListener("message", (ev) => {
          let raw: unknown;
          try {
            raw = JSON.parse(ev.data);
          } catch {
            // Evento WS malformado: se ignora, el siguiente tick lo corrige.
            return;
          }
          const msg = parseJobEvent(raw);
          if (!msg.ok) {
            // Evento con forma rota: se ignora, el siguiente tick lo corrige.
            return;
          }
          onEvent(jobId, msg.value.status, msg.value.progress, msg.value.stage, myGen);
        });
        const onDrop = () => {
          if (!settled && myGen === gen) startPolling(jobId, myGen);
        };
        socket.addEventListener("error", onDrop);
        socket.addEventListener("close", onDrop);
      }

      if (form) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          lastFd = new FormData(form);
          autoRetried = false;
          await startJob(lastFd);
        });
      }

      async function startJob(fd: FormData): Promise<void> {
        stopLive();
        settled = false;
        const myGen = ++gen;
        clearResult();
        setStageText("enviando...");
        setProgress(0);
        const healthy = await checkContractHealth();
        if (!healthy.ok) return;
        if (myGen !== gen) return;
        const res = await fetch(`${api}${API_PATHS.compare}`, { method: "POST", body: fd });
        let rawBody: unknown;
        try {
          rawBody = await res.json();
        } catch {
          setStageText(`error ${res.status}: invalid response`);
          return;
        }
        if (!res.ok) {
          const detail = errorDetail(rawBody);
          setStageText(`error ${res.status}: ${detail}`);
          return;
        }
        const parsed = parseCompareResponse(rawBody);
        if (!parsed.ok) {
          setStageText(`error ${res.status}: invalid response`);
          return;
        }
        const jobId = parsed.value.jobId;
        setStageText(`job ${jobId}: en cola...`);
        subscribe(jobId, myGen);
      }
    </script>
  </body>
</html>
